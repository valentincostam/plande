{
	"mcp": {
		"playwriter": {
			"type": "local",
			"command": ["npx", "-y", "playwriter@latest"],
			"environment": {
				"PLAYWRITER_AUTO_ENABLE": "1"
			}
		}
	},
	"permission": {
		"bash": {
			"ls": "allow",
			"cat": "allow",
			"head": "allow",
			"tail": "allow",
			"grep": "allow",
			"find": "allow",
			"wc": "allow",
			"echo": "allow",
			"pwd": "allow",
			"which": "allow",
			"whoami": "allow",
			"date": "allow",
			"env": "allow",
			"sort": "allow",
			"uniq": "allow",
			"cut": "allow",
			"tr": "allow",
			"diff": "allow",
			"file": "allow",
			"stat": "allow",
			"mkdir": "allow",
			"touch": "allow",
			"cp": "allow",
			"mv": "allow",
			"tree": "allow",
			"jq": "allow",
			"sed": "allow",
			"awk": "allow",
			"git status": "allow",
			"git diff": "allow",
			"git log": "allow",
			"git branch": "allow",
			"git add": "allow",
			"git commit": "allow",
			"git show": "allow",
			"git stash": "allow",
			"git checkout": "allow",
			"git mv": "allow",
			"bun run": "allow",
			"bun test": "allow",
			"bun add": "allow",
			"bun install": "allow",
			"node": "allow",
			"curl": "allow",
			"xargs": "allow",
			"bunx": "allow"
		}
	},
	"$schema": "https://opencode.ai/config.json"
}
